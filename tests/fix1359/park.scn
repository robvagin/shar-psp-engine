# 1359 п. 2: L4 m1 этап 1.1.2, cPolice стоит у Lard Lad без ИИ (режим NULL). Машина игрока таранит её; урон cPolice (MCAR dmg=) должен остаться 0 (машина без ИИ неуязвима до выдачи ей ИИ).
scene F_L1
flag cfgdefaults 1
flag repair
wait 6
scene F_GO4_L4
flag golevel 4
wait 25
flag msnbot 1
flag msnbotpass 0
flag msnmainat 2
wait 10
flag drive
wait 3
goto 241 366.1 -1.5708
wait 1
goto 239.5 366.1 -1.5708
wait 1
goto 238.5 366.1 -1.5708
wait 2
goto 238 366.1 -1.5708
wait 3
end
